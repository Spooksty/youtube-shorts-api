DATABASE_URL=postgresql+psycopg://yt:yt@db:5432/ytauto
DATA_DIR=/data
TZ=Europe/Riga
SECRET_KEY=change-me

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# without keys the local/mock versions are used
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
PIXABAY_API_KEY=
FALLAI_API_KEY=
PEXELS_API_KEY=

# visuals, tried in this order for every scene
# options: pixabay, pexels, fal_images, openai, fal_video, placeholder
MEDIA_PROVIDER=pixabay,fal_images
PIXABAY_PORTRAIT_ONLY=false

# vision model rates every clip/image 0-10 before it's used
VISION_CHECK=true
VISION_MODEL=gpt-4o-mini
VISION_MIN_SCORE=7

FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_IMAGE_COST_EUR=0.003
FAL_VIDEO_MODEL=minimax/h3-max-turbo/text-to-video
FAL_VIDEO_RESOLUTION=768P
FAL_VIDEO_COST_PER_SECOND_EUR=0.037
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_COST_EUR=0.01

# how often mock APIs fail on purpose (to see retries in the log)
MOCK_FAILURE_RATE=0.1
